# Copy to .env and fill in, or export these as real environment variables /
# GitHub Actions secrets. Never commit the filled-in version.

# Gemini API key for process/classify.py — create one for free at
# https://aistudio.google.com/apikey (no credit card required for Flash models)
GEMINI_API_KEY=

# SMTP for send/mailer.py — Gmail app password, AWS SES SMTP creds, or any relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Comma-separated recipient list for the digest — keeps real emails out of
# the committed config.yaml. Falls back to config.yaml's recipients.to if unset.
DIGEST_RECIPIENTS=
